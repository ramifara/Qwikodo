{
  "name": "qwikodo",
  "private": true,
  "version": "0.2.0",
  "description": "A small, private, cross-platform barcode scanner.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "npm run test:fixtures",
    "test:fixtures": "node scripts/fixtures.mjs",
    "check": "npm run build && npm test && npm run check:versions && npm run check:rust",
    "check:versions": "node scripts/check-versions.mjs",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "icons": "tauri icon assets/macOS/AppIcon.iconset/icon_512x512@2x.png",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.15",
    "zxing-wasm": "^3.1.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  }
}
